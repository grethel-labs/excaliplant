{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "excaliplant element hook contract",
  "description": "Excalidraw hook and tooltip metadata and serialized browser hook event details.",
  "$ref": "#/$defs/sceneHook",
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" },
      "maxItems": 32,
      "uniqueItems": true
    },
    "elementTooltip": {
      "type": "string",
      "pattern": "\\S"
    },
    "style": {
      "type": "object",
      "properties": {
        "fill": { "type": "string" },
        "stroke": { "type": "string" },
        "text": { "type": "string" },
        "fontSize": { "type": "number" },
        "strokeWidth": { "type": "number" },
        "strokeStyle": { "enum": ["solid", "dashed", "dotted"] },
        "rounded": { "type": "boolean" }
      }
    },
    "sceneHook": {
      "type": "object",
      "required": ["name", "hover", "click"],
      "anyOf": [{ "required": ["id"] }, { "required": ["classes"] }],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "classes": { "$ref": "#/$defs/classes", "minItems": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parent": { "type": "string", "minLength": 1 },
        "clickFromChildren": { "const": true },
        "clickMode": { "enum": ["toggle", "button"], "default": "toggle" },
        "hover": { "$ref": "#/$defs/style" },
        "click": { "$ref": "#/$defs/style" }
      }
    },
    "hookEventDetail": {
      "type": "object",
      "required": ["classes", "type", "active", "elementId"],
      "anyOf": [{ "required": ["id"] }, { "properties": { "classes": { "minItems": 1 } } }],
      "dependentSchemas": {
        "sourceElementId": { "properties": { "type": { "const": "click" } } },
        "clickMode": { "properties": { "type": { "const": "click" }, "active": { "const": true } } }
      },
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "classes": { "$ref": "#/$defs/classes" },
        "type": { "enum": ["hover", "click"] },
        "active": { "type": "boolean" },
        "clickMode": { "const": "button" },
        "elementId": { "type": "string", "minLength": 1 },
        "sourceElementId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
