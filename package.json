{
  "name": "@grethel-labs/excaliplant",
  "version": "0.0.0-development",
  "description": "Render PlantUML as hand-drawn Excalidraw diagrams, SVG and PNG.",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./types/index.d.mts",
  "bin": {
    "excaliplant": "bin/excaliplant.mjs",
    "excaliplant-mcp": "bin/excaliplant-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./svg": "./src/render/svg.mjs",
    "./png": "./src/render/png.mjs",
    "./hooks": {
      "types": "./types/browser/hooks.d.mts",
      "default": "./src/browser/hooks.mjs"
    },
    "./preprocess": "./src/core/preprocess/preprocessor.mjs",
    "./registry": "./src/core/registry.mjs",
    "./markdown": "./src/markdown/index.mjs",
    "./markdown-it": "./src/markdown/markdown_it.mjs",
    "./remark": "./src/markdown/remark.mjs",
    "./mcp": "./src/mcp/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "skills/",
    "assets/brand/logo-*.svg",
    "assets/fonts/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "guardrails": "node --test test/guardrails.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "types": "tsc -p tsconfig.types.json",
    "site": "node scripts/site.mjs _site",
    "site:smoke": "node scripts/site-smoke.mjs _site",
    "themes": "node scripts/themes.mjs",
    "themes:check": "node scripts/themes.mjs --check",
    "docs": "npm run themes && node scripts/docs.mjs && node scripts/gen-plugin-icons.mjs && node scripts/skills.mjs && node scripts/gen-mcp-examples.mjs",
    "docs:check": "npm run themes:check && node scripts/gen-font-metrics.mjs --check && node scripts/docs.mjs --check && node scripts/skills.mjs --check && node scripts/gen-mcp-examples.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run docs:check",
    "prepack": "npm run types",
    "spec:update": "node scripts/update-excalidraw-spec.mjs && node scripts/skills.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grethel-labs/excaliplant.git"
  },
  "homepage": "https://github.com/grethel-labs/excaliplant#readme",
  "bugs": "https://github.com/grethel-labs/excaliplant/issues",
  "keywords": [
    "plantuml",
    "excalidraw",
    "diagram",
    "uml",
    "sequence-diagram",
    "class-diagram",
    "svg",
    "png",
    "elk",
    "hand-drawn",
    "markdown",
    "markdown-it-plugin",
    "remark-plugin",
    "unified-plugin",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent-skill",
    "claude-code-plugin",
    "gemini-cli-extension",
    "codex-plugin"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.12.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "mcpName": "io.github.grethel-labs/excaliplant"
}
